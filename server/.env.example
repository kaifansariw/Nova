# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# Option 1: Leave commented out to use the built-in auto-starting In-Memory MongoDB (zero installation required).
# Option 2: Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/nova_team_db
# Option 3: MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nova_team_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=nova_team_jwt_secret_dev_key_2026_super_secure

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
